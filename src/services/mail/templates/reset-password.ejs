<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        />
        <title>Reset Your Password</title>
    </head>

    <body
        style="
            margin: 0;
            padding: 0;
            background-color: #f5f5f5;
            font-family: Arial, sans-serif;
        "
    >
        <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            style="padding: 40px 20px;"
        >
            <tr>
                <td align="center">
                    <table
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        style="
                            max-width: 600px;
                            background-color: #ffffff;
                            border-radius: 10px;
                            padding: 40px;
                        "
                    >
                        <tr>
                            <td>
                                <h2 style="margin: 0 0 20px; color: #111111; font-size: 24px;">
                                    Reset your Vaulty password
                                </h2>

                                <p style="margin: 0 0 16px; color: #333333; font-size: 16px; line-height: 1.6;">
                                    Hello <%= name %>,
                                </p>

                                <p style="margin: 0 0 16px; color: #333333; font-size: 16px; line-height: 1.6;">
                                    We received a request to reset your Vaulty password.
                                </p>

                                <p style="margin: 0 0 24px; color: #333333; font-size: 16px; line-height: 1.6;">
                                    Use the verification code below to reset your password:
                                </p>

                                <!-- OTP Box with 1-click select and monospaced layout -->
                                <div
                                    style="
                                        margin: 24px 0;
                                        padding: 24px 16px;
                                        background-color: #f5f5f5;
                                        border-radius: 8px;
                                        text-align: center;
                                    "
                                >
                                    <div
                                        style="
                                            margin: 0 0 8px;
                                            color: #666666;
                                            font-size: 12px;
                                            text-transform: uppercase;
                                            letter-spacing: 1px;
                                        "
                                    >
                                        Verification Code
                                    </div>
                                    <div
                                        style="
                                            font-family: 'Courier New', Courier, monospace;
                                            font-size: 32px;
                                            font-weight: bold;
                                            letter-spacing: 6px;
                                            color: #111111;
                                            user-select: all;
                                            -webkit-user-select: all;
                                            -moz-user-select: all;
                                        "
                                    ><%= otp %></div>
                                </div>

                                <p style="margin: 0 0 12px; color: #555555; font-size: 14px; line-height: 1.6;">
                                    This verification code will expire in 5 minutes.
                                </p>

                                <p style="margin: 0 0 24px; color: #666666; font-size: 13px; line-height: 1.6;">
                                    If you didn't request a password reset, you can safely ignore this email.
                                </p>

                                <p style="margin: 0; color: #333333; font-size: 14px; line-height: 1.6;">
                                    Thanks,<br />
                                    Vaulty Team
                                </p>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>