<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verify your Vaulty email</title>
</head>
<body
  style="
    margin: 0;
    padding: 0;
    background-color: #f4f4f5;
    font-family: Arial, Helvetica, sans-serif;
  "
>
  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    style="padding: 40px 20px;"
  >
    <tr>
      <td align="center">
        <table
          width="100%"
          cellpadding="0"
          cellspacing="0"
          style="
            max-width: 520px;
            background-color: #ffffff;
            border-radius: 12px;
            padding: 40px;
          "
        >
          <tr>
            <td>
              <h1
                style="
                  margin: 0 0 24px;
                  color: #18181b;
                  font-size: 28px;
                "
              >
                Verify your email
              </h1>

              <p
                style="
                  margin: 0 0 16px;
                  color: #3f3f46;
                  font-size: 16px;
                  line-height: 1.6;
                "
              >
                Hi <%= name %>,
              </p>

              <p
                style="
                  margin: 0 0 24px;
                  color: #3f3f46;
                  font-size: 16px;
                  line-height: 1.6;
                "
              >
                Use this verification code to confirm your email address for your Vaulty account:
              </p>

              <!-- OTP Container -->
              <div
                style="
                  margin: 0 0 24px;
                  padding: 24px 16px;
                  background-color: #f4f4f5;
                  border-radius: 8px;
                  text-align: center;
                "
              >
                <div
                  style="
                    margin: 0 0 6px;
                    color: #71717a;
                    font-size: 13px;
                    text-transform: uppercase;
                    letter-spacing: 1px;
                  "
                >
                  Verification Code
                </div>

                <!-- user-select: all allows 1-click select on supported clients -->
                <div
                  style="
                    font-family: 'Courier New', Courier, monospace;
                    color: #18181b;
                    font-size: 32px;
                    font-weight: 700;
                    letter-spacing: 6px;
                    user-select: all;
                    -webkit-user-select: all;
                    -moz-user-select: all;
                  "
                ><%= otp %></div>
              </div>

              <p
                style="
                  margin: 0 0 12px;
                  color: #52525b;
                  font-size: 14px;
                  line-height: 1.6;
                "
              >
                This code expires in 5 minutes.
              </p>

              <p
                style="
                  margin: 0;
                  color: #71717a;
                  font-size: 13px;
                  line-height: 1.6;
                "
              >
                If you did not request this verification code, you can safely ignore this email.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>