<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0"
		/>
		<title>Reset Your Password</title>
	</head>

	<body
		style="
			margin: 0;
			padding: 0;
			background-color: #f5f5f5;
			font-family: Arial, sans-serif;
		"
	>
		<div
			style="
				max-width: 600px;
				margin: 40px auto;
				padding: 40px;
				background-color: #ffffff;
				border-radius: 10px;
			"
		>
			<h2 style="margin-bottom: 20px;">
				Reset your Vaulty password
			</h2>

			<p>Hello <%= fullName %>,</p>

			<p>
				We received a request to reset your Vaulty password.
			</p>

			<p>
				Use the verification code below to reset your password:
			</p>

			<div
				style="
					margin: 30px 0;
					padding: 20px;
					background-color: #f5f5f5;
					border-radius: 8px;
					text-align: center;
				"
			>
				<span
					style="
						font-size: 32px;
						font-weight: bold;
						letter-spacing: 8px;
						color: #111111;
					"
				>
					<%= otp %>
				</span>
			</div>

			<p>
				This verification code will expire in 5 minutes.
			</p>

			<p>
				If you didn't request a password reset, you can safely
				ignore this email.
			</p>

			<p>
				Thanks,<br />
				Vaulty Team
			</p>
		</div>
	</body>
</html>