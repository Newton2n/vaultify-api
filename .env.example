
# Application
PORT=5000
APP_URL=http://localhost:5000

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/vaultify"

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# JWT Authentication
JWT_ACCESS_SECRET="replace_with_a_secure_access_secret"
JWT_REFRESH_SECRET="replace_with_a_secure_refresh_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Upstash Redis
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token"

# SMTP Configuration
SMTP_USER="your_smtp_username"
SMTP_EMAIL_SENDER="your_sender_email@example.com"
SMTP_PASSWORD="your_smtp_password"

# Encryption
# Must be exactly 64 hexadecimal characters (32 bytes)
ENCRYPTION_KEY="replace_with_64_character_hex_key"
